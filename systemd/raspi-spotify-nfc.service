[Unit]
Description=TapTune service
# install-service.sh --lite adds the Lite receiver ordering; --desktop sets the audio user.
# The app connects the Bluetooth speaker itself (boot, then tags that start music).
Wants=network-online.target
After=network-online.target bluetooth.service
# Never give up restarting: a slow boot must not leave TapTune stopped.
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/pi/TapTune
ExecStart=/home/pi/TapTune/.venv/bin/python -m app.main
Restart=always
RestartSec=5
EnvironmentFile=/home/pi/TapTune/.env
Environment=PYTHONUNBUFFERED=1
SyslogIdentifier=taptune

[Install]
WantedBy=multi-user.target
