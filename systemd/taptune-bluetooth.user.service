[Unit]
Description=TapTune desktop Bluetooth reconnect and audio routing
After=pipewire-pulse.service wireplumber.service
Wants=pipewire-pulse.service wireplumber.service

[Service]
ExecStart=/bin/bash "%h/.local/lib/taptune/taptune-bluetooth.sh"
EnvironmentFile=%h/.config/taptune/bluetooth.env
Environment=AUDIO_BACKEND=pulseaudio
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
