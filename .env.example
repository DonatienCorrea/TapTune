# Copy this file to .env and fill in the Spotify values only for live mode.
# If any live Spotify value is blank, the app uses its safe fake client.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
SPOTIFY_REFRESH_TOKEN=
APP_HOST=0.0.0.0
APP_PORT=5000
DATABASE_PATH=./data/raspi_spotify_nfc.db
# Leave false for local development and first-card setup; set true on the Pi after the PN532 diagnostic passes.
NFC_READER_ENABLED=false
# Spotify Connect name of the receiver installed by systemd/install-speaker.sh.
# When nothing is playing, TapTune sends music to this device. Leave empty to disable.
SPOTIFY_DEVICE_NAME=TapTune
# Bluetooth speaker address (from `bluetoothctl devices`), kept connected by taptune-bluetooth.service.
BLUETOOTH_SPEAKER_MAC=
# ALSA output used for the "ready" sound (bluealsa = the connected Bluetooth speaker).
AUDIO_OUTPUT_DEVICE=bluealsa
# Play a short sound once the Pi speaker is ready to receive music.
READY_SOUND_ENABLED=true
