# TapTune settings. ./install.sh writes .env for you; edit only if needed.
# Spotify Connect name of the Pi. Pick it once in the Spotify app (Devices).
SPOTIFY_DEVICE_NAME=TapTune
# Volume (0-100) set once when TapTune starts.
SPOTIFY_INITIAL_VOLUME=10
# Bluetooth speaker address. Easier: choose it on the setup page.
BLUETOOTH_SPEAKER_MAC=
# Short sound when TapTune is ready to play.
READY_SOUND_ENABLED=true
APP_HOST=0.0.0.0
APP_PORT=5000
DATABASE_PATH=./data/raspi_spotify_nfc.db
# The installer's service also serves http://<hostname>.local (port 80) and the
# Wi-Fi setup hotspot. Uncomment to opt out.
# TAPTUNE_HTTP_PORT_80=false
# TAPTUNE_WIFI_SETUP=false
