# Copy this file to .env and fill in the Spotify values only for live mode.
# If any live Spotify value is blank, the app uses its safe fake client.
# Spotify receiver on the Pi. go-librespot (written by `./install.sh --lite|--desktop`
# into a new .env): choose SPOTIFY_DEVICE_NAME once in the Spotify app, no developer
# app needed for tags; the SPOTIFY_CLIENT_* values below then only enable the music
# browser. Empty or legacy: Raspotify (Lite) / Spotifyd (Desktop) driven by the
# Spotify Web API (all three values below required), or the fake client.
SPOTIFY_RECEIVER=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
SPOTIFY_REFRESH_TOKEN=
APP_HOST=0.0.0.0
APP_PORT=5000
# Lite/Desktop also serve http://<hostname>.local on port 80. Uncomment to opt out.
# TAPTUNE_HTTP_PORT_80=false
# Lite/Desktop enable the Wi-Fi fallback in systemd. Uncomment to opt out.
# TAPTUNE_WIFI_SETUP=false
DATABASE_PATH=./data/raspi_spotify_nfc.db
# Leave false for local development and first-card setup; set true on the Pi after the PN532 diagnostic passes.
NFC_READER_ENABLED=false
# Spotify Connect name of the receiver (go-librespot, or legacy Raspotify/Spotifyd).
# When Spotify has no current device, TapTune targets this name. Paused devices still count.
# Leave empty to disable local targeting.
SPOTIFY_DEVICE_NAME=TapTune
# Set the Pi receiver's volume once when TapTune starts (even with the chime disabled).
SPOTIFY_INITIAL_VOLUME=10
# Bluetooth address (from `bluetoothctl devices`). TapTune connects it once at boot
# and then only when a tag starts or resumes music on the Pi (never for pause or
# volume), so a speaker that sleeps while idle is fine.
BLUETOOTH_SPEAKER_MAC=
# Legacy Lite (Raspotify) ALSA output; bluealsa targets BLUETOOTH_SPEAKER_MAC. Desktop
# and go-librespot play through the audio user's PipeWire (set by install-service.sh).
AUDIO_OUTPUT_DEVICE=bluealsa
# Play a short sound after TapTune, its enabled reader, Spotify and speaker audio are ready.
READY_SOUND_ENABLED=true
